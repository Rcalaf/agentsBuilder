# Copy to .env and adjust. .env is git-ignored.

# Postgres + pgvector from docker-compose.yml
AGENTSBUILDER_DATABASE_URL=postgresql://agentsbuilder:agentsbuilder@localhost:5433/agentsbuilder

# Any OpenAI-compatible model server. Ollama by default; vLLM later.
AGENTSBUILDER_LLM_BASE_URL=http://localhost:11434/v1
AGENTSBUILDER_LLM_API_KEY=not-needed

# Chat model: left empty on purpose. Choose it once we know the hardware.
AGENTSBUILDER_CHAT_MODEL=
# Multilingual embedding model (Catalan / Spanish / English).
AGENTSBUILDER_EMBEDDING_MODEL=bge-m3

# Every stored record and trace carries a tenant id from day one.
AGENTSBUILDER_DEFAULT_TENANT_ID=dev
